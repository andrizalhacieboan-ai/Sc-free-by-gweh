{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/public/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "DB_HOST": "mysql.railway.andri",
    "DB_USER": "root",
    "DB_PASSWORD": "oTJruxCBQGyqnmbUbfwzsmqUXFtMLyFF",
    "DB_NAME": "@db_name",
    "JWT_SECRET": "@jwt_secret",
    "GOOGLE_CLIENT_ID": "@google_client_id",
    "NODE_ENV": "production"
  }
}
